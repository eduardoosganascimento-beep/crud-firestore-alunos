# ---------------------------------------------------------------------------
# CONFIGURAÇÃO OPCIONAL
#
# Por padrão a aplicação usa o arquivo serviceAccountKey.json na raiz do
# projeto. Se preferir usar variáveis de ambiente, copie este arquivo para
# ".env" e descomente/preencha as três variáveis abaixo.
#
# A chave privada deve ficar entre aspas e as quebras de linha devem ser
# escritas como \n (a aplicação converte de volta para quebras reais).
# ---------------------------------------------------------------------------

# FIREBASE_PROJECT_ID=seu-projeto-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# Alternativa: apontar para o caminho do JSON (pode ser absoluto ou relativo
# à raiz do projeto).
# GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
